{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "companion": {
      "type": "object",
      "title": "FF14 Bridge",
      "properties": {
        "bridge_base_url": {
          "type": "string",
          "title": "Bridge 地址",
          "description": "仅支持本机回环地址，例如 http://127.0.0.1:17891。",
          "default": "http://127.0.0.1:17891"
        },
        "request_timeout_seconds": {
          "type": "number",
          "title": "请求超时（秒）",
          "minimum": 0.2,
          "maximum": 10,
          "default": 3
        },
        "max_event_age_seconds": {
          "type": "integer",
          "title": "事件最大延迟（秒）",
          "minimum": 1,
          "maximum": 120,
          "default": 15
        },
        "proactive_speech_enabled": {
          "type": "boolean",
          "title": "允许主动语音",
          "description": "阶段 1 默认关闭；开启后仍需 Bridge 事件策略和 N.E.K.O. 语音会话支持。"
        },
        "zone_greeting_enabled": {
          "type": "boolean",
          "title": "允许区域问候",
          "description": "阶段 1 默认关闭。"
        },
        "min_trigger_priority": {
          "type": "integer",
          "title": "触发播报最低优先级",
          "minimum": 0,
          "maximum": 10,
          "default": 8
        },
        "zone_greeting_cooldown_seconds": {
          "type": "integer",
          "title": "区域问候冷却时间（秒）",
          "minimum": 30,
          "maximum": 3600,
          "default": 180
        },
        "global_speech_cooldown_seconds": {
          "type": "integer",
          "title": "主动播报全局冷却（秒）",
          "minimum": 1,
          "maximum": 60,
          "default": 5
        }
      }
    }
  }
}
